# Anker cloud account. The password is never printed.
ANKERUSER=
ANKERPASSWORD=
ANKERCOUNTRY=US

# Husky 2 Bluetooth radio.
# HUSKY_BT_ADDRESS is the MAC, for example AA:BB:CC:DD:EE:FF.
HUSKY_BT_NAME=
HUSKY_BT_ADDRESS=

# Anker SOLIX F3800.
# ANKER_BT_ADDRESS is the MAC printed on the station.
# ANKER_BT_IDENTITY is the MAC in the Bluetooth advertisement.
# It is often the label MAC with the last octet increased by one.
# ANKER_HOST is the station LAN address, for example 192.0.2.10.
# ANKER_SERIAL limits cloud reads to one station. Leave it empty to use the A1790 on the account.
ANKER_BT_NAME=
ANKER_BT_ADDRESS=
ANKER_BT_IDENTITY=
ANKER_HOST=
ANKER_SERIAL=
